# NetBox connection settings
# Required: Base URL for your NetBox instance
NETBOX_URL=http://localhost:8000

# Required: NetBox API token with permission to read/write device types
NETBOX_TOKEN=your-netbox-api-token-here

# Device Type Library source repository
# Optional: Git URL for the source repo
REPO_URL=https://github.com/netbox-community/devicetype-library.git

# Optional: Branch to clone/pull
REPO_BRANCH=main

# Optional: Local path where the repository should be cloned
REPO_PATH=./devicetype_importer/repo

# Import filters
# Optional: Ignore TLS/SSL certificate errors (true/false)
IGNORE_CERT_ERRORS=false

# Optional: Comma-separated vendor slugs/names to import, empty means all
VENDORS=

# Optional: Comma-separated device type slugs to import, empty means all
SLUGS=

# Optional feature toggles
# Enable module bay/module type import support (true/false)
NETBOX_FEATURE_MODULES=false

# Logging options
# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Output logs as JSON (true/false)
LOG_JSON=false

# Optional: Log file path (leave empty for console-only logging)
LOG_FILE=

# Optional: Rotation policy for file logging
LOG_ROTATION=10 MB

# Optional: Retention policy for file logging
LOG_RETENTION=7 days
